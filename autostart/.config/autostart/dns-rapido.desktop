[Desktop Entry]
Type=Application
Name=Dotfiles: DNS mais rápido
Comment=Mede os resolvedores e aplica o mais rápido, a cada logon
Exec=bash -c "d=\\$HOME/.local/state/dotfiles; mkdir -p \\$d; \\$HOME/.dotfiles/bin/dns-rapido.sh >> \\$d/dns-rapido.log 2>&1"
X-KDE-autostart-after=panel
NoDisplay=true
