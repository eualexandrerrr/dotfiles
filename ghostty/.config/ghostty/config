# ─── Aparência ────────────────────────────────────────────────
theme = Catppuccin Mocha

font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = calt
font-feature = liga
font-thicken = true

# Respiro interno — o que mais muda a sensação de "bonito"
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true

# Fundo opaco. Transparência atrapalha a leitura do texto sobre a janela de trás.
background-opacity = 1

# Cursor
cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 2

# ─── Janela ───────────────────────────────────────────────────
window-decoration = true
window-theme = ghostty
gtk-titlebar = true
gtk-tabs-location = top
window-inherit-working-directory = true
confirm-close-surface = false

# ─── Scrollback e comportamento ───────────────────────────────
scrollback-limit = 100000
copy-on-select = clipboard
mouse-hide-while-typing = true
link-url = true
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ─── Atalhos ──────────────────────────────────────────────────
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Ctrl+Backspace apaga a palavra. Manda Ctrl+W (\x17), que o zsh e as TUIs leem
# como backward-kill-word. Nao usar ESC+DEL: o Claude Code le o ESC solto como
# interromper e engole o resto.
keybind = ctrl+backspace=text:\x17

# Ctrl+Shift+E digita /explica e envia. Como copy-on-select ja joga a selecao no
# clipboard, basta marcar o texto com o mouse e apertar o atalho.
keybind = ctrl+shift+e=text:/explica\n
