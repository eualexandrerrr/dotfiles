# Deriva do PKGBUILD do AUR (hyprexpose-git, de ThiagoAVicente), com um patch local
# que adiciona a chave ignore_monitors e os sinais do Alt+Tab. Upstream: github.com/ThiagoAVicente/hyprexpose
pkgname=hyprexpose-xande
_upstream=hyprexpose
pkgver=r45.9d74169
pkgrel=6
pkgdesc='Overview de workspaces do Hyprland com preview ao vivo, patch do Xande'
arch=('x86_64')
url='https://github.com/ThiagoAVicente/hyprexpose'
license=('MIT')
depends=('wayland' 'cairo' 'pango' 'hyprland')
makedepends=('git' 'rust' 'cargo')
provides=('hyprexpose')
conflicts=('hyprexpose' 'hyprexpose-git')
source=("git+${url}.git" '0001-ignorar-monitores-e-alt-tab.patch')
sha256sums=('SKIP' 'SKIP')

pkgver() {
    cd "$_upstream"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_upstream"
    git checkout .
    patch -p1 < "$srcdir/0001-ignorar-monitores-e-alt-tab.patch"
}

build() {
    cd "$_upstream"
    cargo build --release --locked
}

package() {
    cd "$_upstream"
    install -Dm755 target/release/hyprexpose "$pkgdir/usr/bin/hyprexpose"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
