[Desktop Entry]
Type=Application
Name=Recorte para a área de transferência
Comment=Seleciona uma região da tela e copia a imagem direto para o clipboard
Exec=bash -c "\\$HOME/.dotfiles/bin/recorte-clipboard.sh"
Icon=spectacle
Terminal=false
StartupNotify=false
NoDisplay=true
X-KDE-GlobalAccel-CommandShortcut=true
