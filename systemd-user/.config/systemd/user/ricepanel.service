[Unit]
Description=RicePanel: painel do monitor vertical (nativo, COSMIC)
PartOf=graphical-session.target
After=graphical-session.target apply-screens.service
# Sem isso os dois sobem juntos no login e o painel pode pedir a saída antes de
# o apply-screens girar e posicionar o monitor.
Wants=apply-screens.service

[Service]
Type=simple
ExecCondition=%h/.dotfiles/bin/monitor.sh vertical
WorkingDirectory=%h/Apps/desktop/RicePanel/cosmic
# Layer surface: o compositor sabe em que saída o painel mora, então não há
# mais ExecStartPost movendo janela. A saída vem do cosmic-config (`saida`).
ExecStart=%h/Apps/desktop/RicePanel/cosmic/target/release/ricepanel
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
