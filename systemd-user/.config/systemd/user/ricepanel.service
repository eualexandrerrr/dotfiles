[Unit]
Description=RicePanel: painel do monitor vertical
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
Type=simple
WorkingDirectory=%h/Apps/desktop/RicePanel
ExecStart=/usr/bin/electron --password-store=basic .
Restart=on-failure
RestartSec=5
Environment=ELECTRON_OZONE_PLATFORM_HINT=auto

[Install]
WantedBy=graphical-session.target
