[Unit]
Description=Sessao: reabre os apps no login e guarda a lista ao sair
Documentation=file:%h/.dotfiles/bin/sessao-apps.sh
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# RemainAfterExit deixa a unit "ativa" depois do ExecStart terminar, e e o que faz o
# ExecStop rodar la no fim -- quando a sessao grafica cai no logout ou no desligamento.
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.dotfiles/bin/sessao-apps.sh restaurar
ExecStop=%h/.dotfiles/bin/sessao-apps.sh salvar

[Install]
WantedBy=graphical-session.target
