[Unit]
Description=Rede de seguranca da lista de apps da sessao

[Timer]
Unit=session-apps-save.service
# No desligamento os scopes dos apps as vezes morrem antes do ExecStop, e a foto sai vazia.
# Este timer mantem uma foto recente pra esse caso -- salvar e barato e nunca sobrescreve
# a lista boa com uma vazia.
OnActiveSec=3min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
