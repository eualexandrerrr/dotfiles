#!/usr/bin/env bash
# Troca entre o desktop Linux e a saida nativa da 3090, sem nunca derrubar a sessao: troca
# a entrada do monitor ASUS e o dono do controlador USB isolado, sem passar pelo Looking
# Glass. O IDD do Looking Glass e a saida fisica da 3090 nao coexistem -- o driver da NVIDIA
# so ativa a saida fisica com o IDD desligado (`nvidia-smi -q` prova: Display Active vira
# Enabled na hora que o IDD cai). Validado ao vivo em 09/09/2026, receita completa no
# ~/Claude/maquina/docs/vm-e-hardware.md, secao "CONFIRMADO em 09/09/2026".
#
# Uso: vm/game-mode entrar   (Linux -> Windows nativo: tela, teclado e mouse direto na VM)
#      vm/game-mode voltar   (Windows -> Linux: devolve tudo, Looking Glass volta a valer)
#
# Atalhos, em qualquer tela: CTRL+ALT+Home no desktop chama "entrar"; CTRL+ALT+Home dentro
# do Windows chama "voltar" -- via `game-mode-listener.py` (sobe aqui) e o hotkey do
# `game-mode-install-windows-shortcut.sh` (instala uma vez la dentro, sobrevive a reboot).
#
# "entrar" tira o teclado e o mouse do host assim que anexa o controlador USB -- tem que ter
# outro jeito de mexer no Linux depois (celular com Claude Remote Control, ou so lembrar que
# CTRL+ALT+Home dentro do Windows devolve tudo).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/guest.sh"

# Por modelo, nao por indice: `--display N` e posicional e muda de ordem quando um cabo sai
# ou a maquina e reinstalada.
MONITOR="${MONITOR:-XG27ACS}"
GUEST_USER="${GUEST_USER:-Alexandre}"
USB_XML="/tmp/modo-jogo-usb.xml"
IDD_ID='ROOT\DISPLAY\0000'
LISTENER_PID="/tmp/modo-jogo-listener.pid"
MARCADOR="/tmp/modo-jogo-ativo"   # eventos.lua le isso pra nao prender o cursor no principal

cat >"$USB_XML" <<'XML'
<hostdev mode='subsystem' type='pci' managed='yes'>
  <source>
    <address domain='0x0000' bus='0x09' slot='0x00' function='0x3'/>
  </source>
</hostdev>
XML

usb_anexado() { sudo virsh dumpxml w11 | grep -q "bus='0x09'.*slot='0x00'.*function='0x3'"; }

corrigir_resolucao() {
    cat >/tmp/modo-jogo-resolucao.ps1 <<'PS1'
$log = 'C:\Windows\Temp\modo-jogo-resolucao.log'
"start" | Out-File $log -Encoding utf8
function L($m) { $m | Out-File $log -Append -Encoding utf8 }
$src = @"
using System;
using System.Runtime.InteropServices;
public class Screen {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct DEVMODE {
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmDeviceName;
    public short dmSpecVersion; public short dmDriverVersion; public short dmSize; public short dmDriverExtra;
    public int dmFields;
    public int dmPositionX; public int dmPositionY; public int dmDisplayOrientation; public int dmDisplayFixedOutput;
    public short dmColor; public short dmDuplex; public short dmYResolution; public short dmTTOption; public short dmCollate;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmFormName;
    public short dmLogPixels;
    public int dmBitsPerPel; public int dmPelsWidth; public int dmPelsHeight; public int dmDisplayFlags; public int dmDisplayFrequency;
    public int dmICMMethod; public int dmICMIntent; public int dmMediaType; public int dmDitherType; public int dmReserved1; public int dmReserved2;
    public int dmPanningWidth; public int dmPanningHeight;
  }
  [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern bool EnumDisplaySettingsW(string dev, int mode, ref DEVMODE dm);
  [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern int ChangeDisplaySettingsW(ref DEVMODE dm, int flags);
}
"@
Add-Type -TypeDefinition $src
$size = [Runtime.InteropServices.Marshal]::SizeOf([type]([Screen+DEVMODE]))

# Sem o IDD, a saida fisica da 3090 vira o dispositivo padrao -- por isso
# [NullString]::Value (nao o nome do IDD, como no guest-display.sh).
$target = $null
$best = 0
for ($m = 0; $m -lt 400; $m++) {
  $dm = New-Object Screen+DEVMODE
  $dm.dmSize = $size
  if (-not [Screen]::EnumDisplaySettingsW([NullString]::Value, $m, [ref]$dm)) { break }
  if ($dm.dmPelsWidth -eq 2560 -and $dm.dmPelsHeight -eq 1440 -and $dm.dmBitsPerPel -eq 32) {
    if ($dm.dmDisplayFrequency -gt $best) { $target = $dm; $best = $dm.dmDisplayFrequency }
  }
}
if ($target -eq $null) { L "2560x1440 not in mode list"; exit 2 }
L "picked $($target.dmPelsWidth)x$($target.dmPelsHeight)@$($target.dmDisplayFrequency)"
$target.dmFields = 0x00080000 -bor 0x00100000 -bor 0x00400000 -bor 0x00040000
L "change = $([Screen]::ChangeDisplaySettingsW([ref]$target, 1))"
PS1
    guest_put /tmp/modo-jogo-resolucao.ps1 'C:/Windows/Temp/modo-jogo-resolucao.ps1'
    rm -f /tmp/modo-jogo-resolucao.ps1

    guest_exec "
\$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -File C:\Windows\Temp\modo-jogo-resolucao.ps1'
\$who = New-ScheduledTaskPrincipal -UserId '$GUEST_USER' -LogonType Interactive -RunLevel Highest
Register-ScheduledTask -TaskName 'dotfiles-modo-jogo-res' -Action \$action -Principal \$who -Force | Out-Null
Start-ScheduledTask -TaskName 'dotfiles-modo-jogo-res'
Start-Sleep -Seconds 6
Unregister-ScheduledTask -TaskName 'dotfiles-modo-jogo-res' -Confirm:\$false
Get-Content C:\Windows\Temp\modo-jogo-resolucao.log
" >/dev/null
}

desligar_idd() {
    cat >/tmp/modo-jogo-idd.ps1 <<'PS1'
$log = 'C:\Windows\Temp\modo-jogo-idd.log'
"start" | Out-File $log -Encoding utf8
function L($m) { $m | Out-File $log -Append -Encoding utf8 }
$src = @"
using System;
using System.Runtime.InteropServices;
public class Idd {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct DISPLAY_DEVICE {
    public int cb;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string DeviceName;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceString;
    public int StateFlags;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceID;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceKey;
  }
  [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern bool EnumDisplayDevicesW(string lpDevice, int iDevNum, ref DISPLAY_DEVICE lpDisplayDevice, int dwFlags);
}
"@
Add-Type -TypeDefinition $src

function IddAnexado {
    $dd = New-Object Idd+DISPLAY_DEVICE
    $dd.cb = [Runtime.InteropServices.Marshal]::SizeOf([type]([Idd+DISPLAY_DEVICE]))
    for ($i = 0; $i -lt 8; $i++) {
        if (-not [Idd]::EnumDisplayDevicesW([NullString]::Value, $i, [ref]$dd, 0)) { break }
        if ($dd.DeviceString -like "*Looking Glass*" -and ($dd.StateFlags -band 1)) { return $true }
    }
    return $false
}

# Disable-PnpDevice comanda a desativacao mas nao espera o Windows tirar o dispositivo do
# desktop -- confirmado em 10/09/2026: o IDD continuava ATTACHED_TO_DESKTOP e primario depois
# do comando "ter sucesso", e a 3090 ficava sem tela nenhuma. Confere e tenta de novo.
for ($tent = 1; $tent -le 3; $tent++) {
    if (-not (IddAnexado)) { L "IDD ja desanexado (tentativa $tent)"; break }
    L "tentativa ${tent}: desligando"
    Disable-PnpDevice -InstanceId 'ROOT\DISPLAY\0000' -Confirm:$false
    for ($s = 0; $s -lt 10; $s++) {
        if (-not (IddAnexado)) { break }
        Start-Sleep -Seconds 1
    }
}
if (IddAnexado) { L "FALHOU: IDD continua anexado" } else { L "IDD desanexado com sucesso" }
PS1
    guest_put /tmp/modo-jogo-idd.ps1 'C:/Windows/Temp/modo-jogo-idd.ps1'
    rm -f /tmp/modo-jogo-idd.ps1

    guest_exec "
\$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -File C:\Windows\Temp\modo-jogo-idd.ps1'
\$who = New-ScheduledTaskPrincipal -UserId '$GUEST_USER' -LogonType Interactive -RunLevel Highest
Register-ScheduledTask -TaskName 'dotfiles-modo-jogo-idd' -Action \$action -Principal \$who -Force | Out-Null
Start-ScheduledTask -TaskName 'dotfiles-modo-jogo-idd'
Start-Sleep -Seconds 35
Unregister-ScheduledTask -TaskName 'dotfiles-modo-jogo-idd' -Confirm:\$false
Get-Content C:\Windows\Temp\modo-jogo-idd.log
" | tee /tmp/modo-jogo-idd-resultado.log
    grep -q "IDD desanexado com sucesso" /tmp/modo-jogo-idd-resultado.log
}

entrar() {
    [[ $(LC_ALL=C sudo virsh domstate w11 2>/dev/null) == running ]] || { echo "modo-jogo: a VM nao esta ligada (vm/w11 3090)" >&2; exit 1; }
    touch "$MARCADOR"
    guest_ready 30 || { echo "modo-jogo: o agente da VM nao respondeu" >&2; exit 1; }

    # O hotkey mora dentro do Windows (tarefa agendada no win.raw), entao sobrevive a format
    # do host mas nao a uma VM recriada. Se faltar, instala sozinho -- sem isso o Ctrl+Alt+Home
    # de volta nao existe e o teclado ja foi pra VM.
    if ! guest_exec "(Get-ScheduledTask -TaskName 'dotfiles-modo-jogo-hotkey' -ErrorAction SilentlyContinue).TaskName" 2>/dev/null | grep -q 'dotfiles-modo-jogo-hotkey'; then
        echo "  instalando o atalho Ctrl+Alt+Home dentro do Windows (estava faltando)"
        bash "$HERE/game-mode-install-windows-shortcut.sh" >/dev/null \
            || echo "modo-jogo: nao consegui instalar o hotkey do Windows -- pra voltar, rode 'vm/game-mode voltar' daqui" >&2
    fi

    echo "  desligando o IDD do Looking Glass"
    desligar_idd || echo "modo-jogo: IDD nao confirmou desligado -- a 3090 pode ficar sem tela" >&2

    if ! usb_anexado; then
        echo "  anexando o controlador USB isolado (teclado e mouse vao pra VM AGORA)"
        sudo virsh attach-device w11 "$USB_XML" --live >/dev/null
    fi

    echo "  trocando o monitor pro DP (3090)"
    sudo ddcutil --model "$MONITOR" setvcp 60 x0f

    echo "  corrigindo a resolucao"
    corrigir_resolucao || echo "modo-jogo: resolucao pode ter ficado errada, ajusta na mao" >&2

    if [[ ! -f $LISTENER_PID ]] || ! kill -0 "$(cat "$LISTENER_PID")" 2>/dev/null; then
        echo "  subindo o listener do Ctrl+Alt+Home (roda dentro do Windows, chama aqui)"
        python3 "$HERE/game-mode-listener.py" "$HERE/modo-jogo" >/tmp/modo-jogo-listener.log 2>&1 &
        echo $! >"$LISTENER_PID"
    fi
}

voltar() {
    rm -f "$MARCADOR"
    if usb_anexado; then
        echo "  devolvendo o controlador USB pro host"
        sudo virsh detach-device w11 "$USB_XML" --live >/dev/null

        # detach-device --live so confirma que o QEMU ACEITOU o pedido (device_del), nao que
        # o Windows de fato soltou o dispositivo -- o hot-unplug de PCI depende do driver do
        # guest processar a remocao por ACPI. Sem esperar, o script seguia em frente e
        # dizia "devolvido" com o teclado e o mouse ainda presos na VM (visto em 10/09/2026).
        for _ in $(seq 1 20); do
            usb_anexado || break
            sleep 0.5
        done
        if usb_anexado; then
            echo "  !! o Windows nao soltou o controlador USB a tempo, tentando de novo" >&2
            sudo virsh detach-device w11 "$USB_XML" --live >/dev/null 2>&1 || true
            for _ in $(seq 1 20); do
                usb_anexado || break
                sleep 0.5
            done
            usb_anexado && echo "  !! teclado e mouse continuam presos na VM -- rode 'vm/game-mode voltar' de novo" >&2
        fi
    fi

    echo "  voltando o monitor pro HDMI (RX 550)"
    sudo ddcutil --model "$MONITOR" setvcp 60 x11

    echo "  religando o IDD do Looking Glass"
    guest_exec "Enable-PnpDevice -InstanceId '$IDD_ID' -Confirm:\$false" >/dev/null

    # Atraso curto: quando quem chamou "voltar" foi o proprio listener (Ctrl+Alt+Home de dentro do
    # Windows), matar ele na hora corta a resposta HTTP no meio antes de terminar de enviar.
    if [[ -f $LISTENER_PID ]]; then
        pid="$(cat "$LISTENER_PID")"
        (sleep 1; kill "$pid" 2>/dev/null) &
        rm -f "$LISTENER_PID"
    fi
}

case "${1:-}" in
    entrar) entrar ;;
    voltar) voltar ;;
    *) echo "uso: modo-jogo entrar|voltar" >&2; exit 1 ;;
esac
