#!/usr/bin/env bash
# Troca entre o desktop Linux e a saida nativa da 3090, sem nunca derrubar o Hyprland: troca
# a entrada do monitor ASUS e o dono do controlador USB isolado, sem passar pelo Looking
# Glass. O IDD do Looking Glass e a saida fisica da 3090 nao coexistem -- o driver da NVIDIA
# so ativa a saida fisica com o IDD desligado (`nvidia-smi -q` prova: Display Active vira
# Enabled na hora que o IDD cai). Validado ao vivo em 09/09/2026, receita completa no
# ~/Claude/maquina/docs/vm-e-hardware.md, secao "CONFIRMADO em 09/09/2026".
#
# Uso: vm/modo-jogo entrar   (Linux -> Windows nativo: tela, teclado e mouse direto na VM)
#      vm/modo-jogo voltar   (Windows -> Linux: devolve tudo, Looking Glass volta a valer)
#
# Atalhos, em qualquer tela: ALT+F2 no Hyprland chama "entrar"; ALT+F1 dentro do Windows
# chama "voltar" -- via `modo-jogo-listener.py` (sobe aqui) e o hotkey do
# `modo-jogo-instalar-atalho-windows.sh` (instala uma vez la dentro, sobrevive a reboot).
#
# "entrar" tira o teclado e o mouse do host assim que anexa o controlador USB -- tem que ter
# outro jeito de mexer no Linux depois (celular com Claude Remote Control, ou so lembrar que
# ALT+F1 dentro do Windows devolve tudo).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/guest.sh"

MONITOR="${MONITOR:-1}"                    # ddcutil --display N do ASUS (principal)
GUEST_USER="${GUEST_USER:-Alexandre}"
USB_XML="/tmp/modo-jogo-usb.xml"
IDD_ID='ROOT\DISPLAY\0000'
LISTENER_PID="/tmp/modo-jogo-listener.pid"

cat >"$USB_XML" <<'XML'
<hostdev mode='subsystem' type='pci' managed='yes'>
  <source>
    <address domain='0x0000' bus='0x09' slot='0x00' function='0x3'/>
  </source>
</hostdev>
XML

usb_anexado() { sudo virsh dumpxml w11 | grep -q "bus='0x09'.*slot='0x00'.*function='0x3'"; }

corrigir_resolucao() {
    cat >/tmp/modo-jogo-resolucao.ps1 <<'PS1'
$log = 'C:\Windows\Temp\modo-jogo-resolucao.log'
"start" | Out-File $log -Encoding utf8
function L($m) { $m | Out-File $log -Append -Encoding utf8 }
$src = @"
using System;
using System.Runtime.InteropServices;
public class Screen {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct DEVMODE {
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmDeviceName;
    public short dmSpecVersion; public short dmDriverVersion; public short dmSize; public short dmDriverExtra;
    public int dmFields;
    public int dmPositionX; public int dmPositionY; public int dmDisplayOrientation; public int dmDisplayFixedOutput;
    public short dmColor; public short dmDuplex; public short dmYResolution; public short dmTTOption; public short dmCollate;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmFormName;
    public short dmLogPixels;
    public int dmBitsPerPel; public int dmPelsWidth; public int dmPelsHeight; public int dmDisplayFlags; public int dmDisplayFrequency;
    public int dmICMMethod; public int dmICMIntent; public int dmMediaType; public int dmDitherType; public int dmReserved1; public int dmReserved2;
    public int dmPanningWidth; public int dmPanningHeight;
  }
  [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern bool EnumDisplaySettingsW(string dev, int mode, ref DEVMODE dm);
  [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern int ChangeDisplaySettingsW(ref DEVMODE dm, int flags);
}
"@
Add-Type -TypeDefinition $src
$size = [Runtime.InteropServices.Marshal]::SizeOf([type]([Screen+DEVMODE]))

# Sem o IDD, a saida fisica da 3090 vira o dispositivo padrao -- por isso
# [NullString]::Value (nao o nome do IDD, como no guest-display.sh).
$target = $null
$best = 0
for ($m = 0; $m -lt 400; $m++) {
  $dm = New-Object Screen+DEVMODE
  $dm.dmSize = $size
  if (-not [Screen]::EnumDisplaySettingsW([NullString]::Value, $m, [ref]$dm)) { break }
  if ($dm.dmPelsWidth -eq 2560 -and $dm.dmPelsHeight -eq 1440 -and $dm.dmBitsPerPel -eq 32) {
    if ($dm.dmDisplayFrequency -gt $best) { $target = $dm; $best = $dm.dmDisplayFrequency }
  }
}
if ($target -eq $null) { L "2560x1440 not in mode list"; exit 2 }
L "picked $($target.dmPelsWidth)x$($target.dmPelsHeight)@$($target.dmDisplayFrequency)"
$target.dmFields = 0x00080000 -bor 0x00100000 -bor 0x00400000 -bor 0x00040000
L "change = $([Screen]::ChangeDisplaySettingsW([ref]$target, 1))"
PS1
    guest_put /tmp/modo-jogo-resolucao.ps1 'C:/Windows/Temp/modo-jogo-resolucao.ps1'
    rm -f /tmp/modo-jogo-resolucao.ps1

    guest_exec "
\$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -File C:\Windows\Temp\modo-jogo-resolucao.ps1'
\$who = New-ScheduledTaskPrincipal -UserId '$GUEST_USER' -LogonType Interactive -RunLevel Highest
Register-ScheduledTask -TaskName 'dotfiles-modo-jogo-res' -Action \$action -Principal \$who -Force | Out-Null
Start-ScheduledTask -TaskName 'dotfiles-modo-jogo-res'
Start-Sleep -Seconds 6
Unregister-ScheduledTask -TaskName 'dotfiles-modo-jogo-res' -Confirm:\$false
Get-Content C:\Windows\Temp\modo-jogo-resolucao.log
" >/dev/null
}

entrar() {
    [[ $(sudo virsh domstate w11 2>/dev/null) == running ]] || { echo "modo-jogo: a VM nao esta ligada (vm/w11 3090)" >&2; exit 1; }
    guest_ready 30 || { echo "modo-jogo: o agente da VM nao respondeu" >&2; exit 1; }

    echo "  desligando o IDD do Looking Glass"
    guest_exec "Disable-PnpDevice -InstanceId '$IDD_ID' -Confirm:\$false" >/dev/null

    if ! usb_anexado; then
        echo "  anexando o controlador USB isolado (teclado e mouse vao pra VM AGORA)"
        sudo virsh attach-device w11 "$USB_XML" --live >/dev/null
    fi

    echo "  trocando o monitor pro DP (3090)"
    sudo ddcutil --display "$MONITOR" setvcp 60 x0f

    echo "  corrigindo a resolucao"
    corrigir_resolucao || echo "modo-jogo: resolucao pode ter ficado errada, ajusta na mao" >&2

    if [[ ! -f $LISTENER_PID ]] || ! kill -0 "$(cat "$LISTENER_PID")" 2>/dev/null; then
        echo "  subindo o listener do Alt+F1 (roda dentro do Windows, chama aqui)"
        python3 "$HERE/modo-jogo-listener.py" "$HERE/modo-jogo" >/tmp/modo-jogo-listener.log 2>&1 &
        echo $! >"$LISTENER_PID"
    fi
}

voltar() {
    if usb_anexado; then
        echo "  devolvendo o controlador USB pro host"
        sudo virsh detach-device w11 "$USB_XML" --live >/dev/null
    fi

    echo "  voltando o monitor pro HDMI (RX 550)"
    sudo ddcutil --display "$MONITOR" setvcp 60 x11

    echo "  religando o IDD do Looking Glass"
    guest_exec "Enable-PnpDevice -InstanceId '$IDD_ID' -Confirm:\$false" >/dev/null

    # Atraso curto: quando quem chamou "voltar" foi o proprio listener (Alt+F1 de dentro do
    # Windows), matar ele na hora corta a resposta HTTP no meio antes de terminar de enviar.
    if [[ -f $LISTENER_PID ]]; then
        pid="$(cat "$LISTENER_PID")"
        (sleep 1; kill "$pid" 2>/dev/null) &
        rm -f "$LISTENER_PID"
    fi
}

case "${1:-}" in
    entrar) entrar ;;
    voltar) voltar ;;
    *) echo "uso: modo-jogo entrar|voltar" >&2; exit 1 ;;
esac
