#!/usr/bin/env bash
# Troca o perfil da VM w11 e liga. Um dominio so no libvirt, dois XMLs:
#   3090    passthrough da RTX 3090; o host segue desenhando na RX 550 e a tela do Windows
#           aparece pelo Looking Glass (vm/glass)
#   janela  video emulado + SPICE, abre numa janela; sem 3D, nao roda RedM
# Uso: w11 ir | w11 janela | w11 3090 | w11 instalar | w11 perfil | w11 desligar | w11 reiniciar | w11 forcar-desligar
#   instalar = janela + ISO do Windows + autounattend do MyWinISO (perfil vm-jogo); so na primeira vez
#   ir      = 3090 com aviso e confirmacao
# Sem sudo: o usuario esta no grupo libvirt. Os hooks rodam como root dentro do libvirtd.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
v() { virsh -c qemu:///system "$@"; }

estado() { v domstate w11 2>/dev/null || echo "nao definida"; }

# O Plasma lanca cada aplicativo num scope do systemd chamado app-<desktop-id>-<pid>.scope.
# Isso da a lista exata do que o usuario abriu, ja com o id do .desktop pra reabrir depois.
# O restore nativo do Plasma nao serve aqui: em Wayland o ksmserver salva count=0.
salvar_apps() {
    local lista="${XDG_STATE_HOME:-$HOME/.local/state}/w11-apps"
    mkdir -p "$(dirname "$lista")"
    systemctl --user list-units --type=scope --no-legend 'app-*.scope' 2>/dev/null \
        | awk '{print $1}' \
        | sed -n 's/^app-\(.*\)-[0-9]\+\.scope$/\1/p' \
        | while read -r id; do systemd-escape -u -- "$id"; done \
        > "$lista" || true
    [[ -s $lista ]] || rm -f "$lista"
}
perfil() {
    if v dumpxml w11 2>/dev/null | grep -q "<hostdev mode='subsystem' type='pci'"; then echo 3090; else echo janela; fi
}

case "${1:-}" in
    ir)
        if [[ $(estado) == running ]]; then echo "w11 ja esta ligada."; sleep 2; exit 0; fi
        cat <<'TXT'

  ==> Windows + RTX 3090

  Com a RX 550 no host a sessao NAO cai: nada do que esta aberto fecha.
  A 3090 vai inteira pra VM e o Windows aparece pelo Looking Glass:

      vm/glass          janela      (Scroll Lock solta o mouse)
      vm/glass -F       tela cheia

  Se o hook reclamar de amdgpu, a RX 550 nao esta desenhando -- ligar assim
  deixaria o PC sem tela, e por isso ele aborta.

TXT
        read -rp "  Enter para ir, Ctrl+C para cancelar " _
        exec "$0" 3090 ;;
    perfil) echo "perfil: $(perfil)  estado: $(estado)" ;;
    desligar) v shutdown w11 ;;
    reiniciar) v reboot w11 ;;
    forcar-desligar) v destroy w11 ;;
    janela|3090|instalar)
        if [[ $(estado) == running ]]; then
            echo "w11 esta ligada (perfil $(perfil)). Desliga antes: w11 desligar" >&2; exit 1
        fi
        # Os hooks em /etc/libvirt/hooks disparam pelo nome da VM. Sem a checagem de hostdev PCI
        # eles tiram a 3090 do host ate no perfil janela (aconteceu: PC sem tela). Fonte:
        # RedMLinux/plano-b-passthrough, instala com: sudo bash install-hooks.sh w11 alexandre
        if [[ $1 != 3090 ]] && ! grep -q 'hostdev PCI' /etc/libvirt/hooks/qemu.d/w11/prepare/begin/start.sh 2>/dev/null; then
            echo "hook /etc/libvirt/hooks/qemu.d/w11/prepare/begin/start.sh sem a checagem de perfil: ele derrubaria a tela do host. Reinstale os hooks do RedMLinux." >&2; exit 1
        fi
        # Com duas GPUs a sessao nao cai e nada disso e mais necessario. Fica ate o
        # passthrough estar comprovadamente de pe, ai salvar_apps e o reabrir-apps.sh saem.
        [[ $1 == 3090 ]] && salvar_apps
        v define "$HERE/w11-$1.xml" >/dev/null
        v start w11
        if [[ $1 != 3090 ]]; then
            setsid -f virt-viewer -c qemu:///system --attach w11 >/dev/null 2>&1
        fi ;;
    *) sed -n '2,5p' "$0"; exit 2 ;;
esac
