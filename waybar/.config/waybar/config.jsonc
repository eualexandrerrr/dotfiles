{
    "layer": "top",
    "position": "top",
    "output": ["ASUSTek COMPUTER INC XG27ACS T9LMTF068180"],
    "height": 38,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["hyprland/window"],
    "modules-center": ["hyprland/workspaces", "custom/discord", "hyprland/submap"],
    "modules-right": [
        "mpris",
        "cpu",
        "temperature",
        "custom/gpu",
        "memory",
        "pulseaudio",
        "network",
        "tray",
        "clock",
        "custom/transparencia",
        "custom/energia"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "sort-by": "number",
        "format-icons": {
            "1": "\uf268",
            "2": "\uf392",
            "3": "\uf121",
            "4": "\uf17a",
            "5": "\uf489",
            "6": "6",
            "7": "7",
            "8": "8",
            "9": "9",
            "urgent": "!",
            "default": "\u00b7"
        },
        "tooltip-format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "separate-outputs": true,
        "rewrite": {
            "": "área de trabalho"
        }
    },

    "hyprland/submap": {
        "format": "modo: {}",
        "tooltip": false
    },

    "custom/discord": {
        "exec": "$HOME/.dotfiles/bin/discord-notificacoes.sh",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 40,
        "player-icons": {
            "default": "♪",
            "spotify": "",
            "mpv": ""
        },
        "status-icons": {
            "paused": ""
        }
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "on-click": "ghostty -e btop"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 82,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "interval": 4
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{printf \"󰢮 %s%% %s°C\", $1, $2}'",
        "interval": 4,
        "tooltip": false,
        "on-click": "nvidia-settings"
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G de {total:0.1f}G",
        "interval": 4
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " sem som",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "swayosd-client --output-volume mute-toggle",
        "scroll-step": 5
    },

    "network": {
        "format-ethernet": "󰈀 {bandwidthDownBits}",
        "format-wifi": " {essid}",
        "format-disconnected": "󰖪 sem rede",
        "tooltip-format": "{ifname} · {ipaddr}",
        "interval": 3,
        "on-click": "nm-connection-editor"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d/%m}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b>{}</b></span>"
            }
        }
    },

    "custom/transparencia": {
        "format": "\udb80\udd9d",
        "tooltip-format": "Transparência das janelas",
        "on-click": "$HOME/.dotfiles/bin/transparencia.py"
    },

    "custom/energia": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
